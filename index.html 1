<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CarageX | Multi Brand Auto Care & Diagnostics Madhapur</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <style>
    :root {
      --bg-darkest: #0a0c10;
      --bg-dark: #12161f;
      --bg-card: #1a202c;
      --accent-red: #e63946;
      --accent-red-hover: #c1121f;
      --accent-gold: #ffb703;
      --text-white: #f8fafc;
      --text-muted: #94a3b8;
      --border: #2d3748;
      --radius: 10px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, sans-serif;
    }

    body {
      background-color: var(--bg-darkest);
      color: var(--text-white);
      line-height: 1.6;
    }

    /* Top Strip */
    .top-strip {
      background: #000000;
      padding: 10px 5%;
      border-bottom: 1px solid #1f2937;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: var(--text-muted);
      flex-wrap: wrap;
      gap: 8px;
    }
    .top-strip a { color: var(--accent-gold); text-decoration: none; font-weight: 600; }

    /* Header & Navigation */
    header {
      background: rgba(18, 22, 31, 0.95);
      backdrop-filter: blur(8px);
      position: sticky;
      top: 0;
      z-index: 1000;
      border-bottom: 1px solid var(--border);
    }
    .nav-container {
      max-width: 1200px;
      margin: auto;
      padding: 16px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .brand-logo {
      font-size: 24px;
      font-weight: 900;
      color: #fff;
      text-decoration: none;
      display: flex;
      align-items: center;
      gap: 10px;
      letter-spacing: 0.5px;
    }
    /* Logo styling if you upload logo.png */
    .brand-logo img {
      max-height: 40px;
      width: auto;
      object-fit: contain;
    }
    .brand-logo span { color: var(--accent-red); }
    .nav-links {
      display: flex;
      gap: 24px;
      align-items: center;
      list-style: none;
    }
    .nav-links a {
      color: var(--text-white);
      text-decoration: none;
      font-weight: 600;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: color 0.2s ease;
    }
    .nav-links a:hover { color: var(--accent-red); }
    .btn-header-call {
      background: var(--accent-red);
      color: #fff !important;
      padding: 10px 18px;
      border-radius: 6px;
      font-weight: 700 !important;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: background 0.2s ease;
    }
    .btn-header-call:hover { background: var(--accent-red-hover); }

    /* Hero Banner (Fast Track Style) */
    .hero {
      position: relative;
      background: linear-gradient(180deg, rgba(10, 12, 16, 0.75) 0%, rgba(10, 12, 16, 0.95) 100%),
                  url('https://images.unsplash.com/photo-1613214149922-f1809c99b414?auto=format&fit=crop&w=1600&q=80') center/cover no-repeat;
      padding: 120px 20px 90px;
      text-align: center;
      border-bottom: 2px solid var(--border);
    }
    .hero-box { max-width: 850px; margin: auto; }
    .hero-badge {
      display: inline-block;
      background: rgba(230, 57, 70, 0.15);
      border: 1px solid var(--accent-red);
      color: var(--accent-red);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 1px;
      margin-bottom: 18px;
      text-transform: uppercase;
    }
    .hero h1 {
      font-size: clamp(34px, 5.5vw, 56px);
      font-weight: 900;
      line-height: 1.15;
      margin-bottom: 18px;
      text-transform: uppercase;
    }
    .hero h1 span { color: var(--accent-red); }
    .hero p {
      font-size: 18px;
      color: var(--text-muted);
      margin-bottom: 34px;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }
    .hero-actions {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .btn-primary {
      background: var(--accent-red);
      color: #fff;
      padding: 15px 30px;
      border-radius: 6px;
      font-weight: 700;
      text-decoration: none;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      transition: all 0.2s ease;
    }
    .btn-primary:hover { background: var(--accent-red-hover); transform: translateY(-2px); }
    .btn-whatsapp {
      background: #25d366;
      color: #fff;
      padding: 15px 30px;
      border-radius: 6px;
      font-weight: 700;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
    }
    .btn-whatsapp:hover { background: #1eb956; transform: translateY(-2px); }

    /* Fast Track Features Bar */
    .perks-strip {
      max-width: 1200px;
      margin: -40px auto 40px;
      padding: 0 20px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      position: relative;
      z-index: 10;
    }
    .perk-item {
      background: var(--bg-card);
      border: 1px solid var(--border);
      padding: 24px;
      border-radius: var(--radius);
      display: flex;
      align-items: center;
      gap: 18px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.4);
    }
    .perk-item i {
      font-size: 32px;
      color: var(--accent-gold);
    }
    .perk-item h4 { font-size: 17px; margin-bottom: 2px; }
    .perk-item p { font-size: 13px; color: var(--text-muted); }

    /* Sections */
    .section-wrap {
      max-width: 1200px;
      margin: 80px auto;
      padding: 0 20px;
    }
    .section-head {
      text-align: center;
      margin-bottom: 48px;
    }
    .section-head h2 {
      font-size: 34px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }
    .section-head h2 span { color: var(--accent-red); }
    .section-head p { color: var(--text-muted); font-size: 15px; margin-top: 6px; }

    /* Dark Grid Cards */
    .services-dark-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
      gap: 24px;
    }
    .dark-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      transition: all 0.3s ease;
    }
    .dark-card:hover {
      border-color: var(--accent-red);
      transform: translateY(-6px);
      box-shadow: 0 12px 30px rgba(230, 57, 70, 0.15);
    }
    .card-img {
      width: 100%;
      height: 190px;
      object-fit: cover;
      border-bottom: 1px solid var(--border);
    }
    .card-body { padding: 22px; }
    .card-body h3 { font-size: 19px; margin-bottom: 10px; color: #fff; }
    .card-body p { font-size: 14px; color: var(--text-muted); margin-bottom: 16px; }
    .card-link {
      color: var(--accent-gold);
      text-decoration: none;
      font-weight: 700;
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    /* Appointment & Workshop Details */
    .dark-booking-panel {
      background: var(--bg-dark);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 40px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 40px;
    }
    .info-list { margin-top: 24px; }
    .info-row {
      display: flex;
      align-items: flex-start;
      gap: 16px;
      margin-bottom: 22px;
    }
    .info-row i {
      font-size: 20px;
      color: var(--accent-red);
      margin-top: 3px;
    }
    .info-row strong { color: #fff; }
    .info-row p, .info-row a { color: var(--text-muted); text-decoration: none; font-size: 14px; }
    .info-row a:hover { color: var(--accent-gold); }

    /* Dark Input Fields */
    .dark-form { display: flex; flex-direction: column; gap: 14px; }
    .dark-form input, .dark-form select, .dark-form textarea {
      width: 100%;
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: #fff;
      padding: 13px 16px;
      border-radius: 6px;
      outline: none;
      font-size: 14px;
    }
    .dark-form input:focus, .dark-form select:focus, .dark-form textarea:focus {
      border-color: var(--accent-red);
    }
    .btn-submit-dark {
      background: var(--accent-red);
      color: #fff;
      border: none;
      padding: 14px;
      border-radius: 6px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 1px;
      cursor: pointer;
      transition: background 0.2s ease;
    }
    .btn-submit-dark:hover { background: var(--accent-red-hover); }

    /* Floating WhatsApp */
    .floating-wa {
      position: fixed;
      bottom: 24px;
      right: 24px;
      background: #25d366;
      color: #fff;
      width: 58px;
      height: 58px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 30px;
      box-shadow: 0 8px 24px rgba(37, 211, 102, 0.4);
      z-index: 1000;
      text-decoration: none;
    }

    /* Footer */
    footer {
      background: #000;
      border-top: 1px solid var(--border);
      padding: 30px 20px;
      text-align: center;
      font-size: 13px;
      color: var(--text-muted);
    }
    footer a { color: var(--accent-red); text-decoration: none; }
  </style>
</head>
